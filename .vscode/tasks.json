{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure",
      "type": "shell",
      "command": "cmake -B build -S . -DCMAKE_PREFIX_PATH=\"$(brew --prefix glfw 2>/dev/null || echo /opt/homebrew/opt/glfw)\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build minecraft_clone",
      "type": "shell",
      "command": "cmake --build build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["CMake: Configure"],
      "dependsOrder": "sequence",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run minecraft_clone (game)",
      "type": "shell",
      "command": "./minecraft_clone",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "dependsOn": ["Build minecraft_clone"],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    }
  ]
}
